<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="salon_employee_action" model="ir.actions.act_window">
        <field name="name">Empleado</field>
        <field name="res_model">salon.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Gestión del empleado"
              id="empleado_base_menu"
              parent="cliente_base_menu"
              action="salon_employee_action"
              sequence="30"
    />

    <record id="gestion_empleado_view_list" model="ir.ui.view">
        <field name="name">Lista de Empleados</field>
        <field name="model">salon.employee</field>
        <field name="arch" type="xml">
            <tree string="Listado de los empleados">
                <field name="nombre"/>
                <field name="telefono"/>
                <field name="especialidad"/>
                <field name="dia_libre"/>
                <field name="active"/>
                <field name="total_citas"/>
            </tree>
        </field>
    </record>


    <record id="gestion_empleado_form" model="ir.ui.view">
        <field name="name">Formulario del empleado</field>
        <field name="model">salon.employee</field>
        <field name="arch" type="xml">
            <form string="Ficha del empleado">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="telefono"/>
                            <field name="especialidad"/>
                            <field name="dia_libre"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="total_citas" readonly="1"/>
                        </group>

                    </group>
                    <notebook>
                            <page string="citas">
                                <field name="cita_id"/>
                            </page>
                        </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>