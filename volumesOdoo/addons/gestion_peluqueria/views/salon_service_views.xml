<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="salon_service_action" model="ir.actions.act_window">
        <field name="name">Servicio</field>
        <field name="res_model">salon.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Servicios"
              id="servicio_base_menu"
              parent="cliente_base_menu"
              action="salon_service_action"
              sequence="40"
    />

    <record id="gestion_servicio_view_list" model="ir.ui.view">
        <field name="name">Lista de los servicios</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <tree string="Listado de los servicios">
                <field name="nombre"/>
                <field name="especialidad"/>
                <field name="currency_id" invisible="1"/>
                <field name="precio" widget="monetary"/>
            </tree>
        </field>
    </record>


    <record id="gestion_servicio_form" model="ir.ui.view">
        <field name="name">Formulario del servicio</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <form string="Ficha del servicio">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="especialidad"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="precio" widget="monetary"/>
                            <field name="duracion"/>
                        </group>

                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>